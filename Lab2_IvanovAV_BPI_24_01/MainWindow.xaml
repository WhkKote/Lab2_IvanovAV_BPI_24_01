<Window x:Class="Lab2_IvanovAV_BPI_24_01.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="Расчёт формул"
        Width="920"
        Height="900"
        MinWidth="820"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowState="Normal"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42"
                            ResizeBorderThickness="6"
                            CornerRadius="10"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrushDark}"
            BorderThickness="1">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource TitleBarBrush}"
                    BorderBrush="{DynamicResource BorderBrushDark}"
                    BorderThickness="0,0,0,1">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="14,0,0,0">

                        <TextBlock Text="Расчёт формул"
                                   Foreground="{DynamicResource TextBrush}"
                                   FontSize="13"
                                   VerticalAlignment="Center"/>

                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">

                        <RadioButton x:Name="DarkThemeRadioButton"
                                     GroupName="ThemeGroup"
                                     Content="Тёмная"
                                     Tag="Dark"
                                     IsChecked="True"
                                     Margin="0,0,14,0"
                                     VerticalAlignment="Center"
                                     Checked="ThemeRadioButton_Checked"/>

                        <RadioButton x:Name="LightThemeRadioButton"
                                     GroupName="ThemeGroup"
                                     Content="Светлая"
                                     Tag="Light"
                                     Margin="0,0,16,0"
                                     VerticalAlignment="Center"
                                     Checked="ThemeRadioButton_Checked"/>

                        <Button Style="{StaticResource WindowButtonStyle}"
                                Click="MinimizeButton_Click">

                            <Border Width="10"
                                    Height="1"
                                    Background="{DynamicResource TextBrush}"
                                    VerticalAlignment="Center"
                                    SnapsToDevicePixels="True"/>

                        </Button>

                        <Button x:Name="MaximizeButton"
                                Style="{StaticResource WindowButtonStyle}"
                                Click="MaximizeButton_Click">

                            <Rectangle Width="10"
                                       Height="10"
                                       Stroke="{DynamicResource TextBrush}"
                                       StrokeThickness="1"
                                       Fill="Transparent"
                                       SnapsToDevicePixels="True"/>

                        </Button>

                        <Button Style="{StaticResource CloseButtonStyle}"
                                Click="CloseButton_Click">

                            <Grid Width="11"
                                  Height="11">

                                <Path Stroke="{DynamicResource TextBrush}"
                                      StrokeThickness="1.2"
                                      Data="M 0 0 L 11 11"/>

                                <Path Stroke="{DynamicResource TextBrush}"
                                      StrokeThickness="1.2"
                                      Data="M 11 0 L 0 11"/>

                            </Grid>

                        </Button>

                    </StackPanel>

                </Grid>

            </Border>

            <Grid Grid.Row="1"
                  Margin="22">

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="18"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="18"/>
                    <RowDefinition Height="Auto"/>

                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">

                    <TextBlock Text="Расчёт формул"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextBrush}"/>

                    <TextBlock Text="Выберите формулу, введите значения параметров и нажмите «Рассчитать»"
                               Margin="0,3,0,0"
                               FontSize="14"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>

                </StackPanel>

                <ScrollViewer Grid.Row="2"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

                    <StackPanel Margin="0,0,8,0">

                        <Border Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrushDark}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="14"
                                Margin="0,0,0,9">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="125"/>
                                    <ColumnDefinition Width="285"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <RadioButton x:Name="Formula1RadioButton"
                                             Grid.Column="0"
                                             GroupName="FormulaGroup"
                                             Content="Формула 1"
                                             Checked="FormulaRadioButton_Checked"/>

                                <Border Grid.Column="1"
                                        Margin="6,0,14,0"
                                        Background="{DynamicResource FormulaBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrushDark}"
                                        BorderThickness="1"
                                        CornerRadius="7"
                                        Padding="6">

                                    <Image x:Name="Formula1Image"
                                           Height="72"
                                           Stretch="Uniform"/>

                                </Border>

                                <Grid x:Name="Formula1InputGrid"
                                      Grid.Column="2"
                                      IsEnabled="False"
                                      Opacity="0.4">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="A:"
                                               Style="{StaticResource ParameterLabelStyle}"/>

                                    <TextBox x:Name="Formula1ATextBox"
                                             Grid.Column="1"
                                             PreviewTextInput="TextBox_PreviewTextInput"
                                             PreviewKeyDown="TextBox_PreviewKeyDown"
                                             LostFocus="TextBox_LostFocus"/>

                                    <TextBlock Grid.Column="2"
                                               Text="F:"
                                               Style="{StaticResource ParameterLabelStyle}"/>

                                    <ComboBox x:Name="Formula1FComboBox"
                                              Grid.Column="3"/>

                                </Grid>

                            </Grid>

                        </Border>

                        <Border Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrushDark}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="14"
                                Margin="0,0,0,9">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="125"/>
                                    <ColumnDefinition Width="285"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <RadioButton x:Name="Formula2RadioButton"
                                             Grid.Column="0"
                                             GroupName="FormulaGroup"
                                             Content="Формула 2"
                                             Checked="FormulaRadioButton_Checked"/>

                                <Border Grid.Column="1"
                                        Margin="6,0,14,0"
                                        Background="{DynamicResource FormulaBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrushDark}"
                                        BorderThickness="1"
                                        CornerRadius="7"
                                        Padding="6">

                                    <Image x:Name="Formula2Image"
                                           Height="72"
                                           Stretch="Uniform"/>

                                </Border>

                                <Grid x:Name="Formula2InputGrid"
                                      Grid.Column="2"
                                      IsEnabled="False"
                                      Opacity="0.4">

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="7"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="A:"
                                                   Style="{StaticResource ParameterLabelStyle}"/>

                                        <TextBox x:Name="Formula2ATextBox"
                                                 Grid.Column="1"
                                                 PreviewTextInput="TextBox_PreviewTextInput"
                                                 PreviewKeyDown="TextBox_PreviewKeyDown"
                                                 LostFocus="TextBox_LostFocus"/>

                                        <TextBlock Grid.Column="2"
                                                   Text="B:"
                                                   Style="{StaticResource ParameterLabelStyle}"/>

                                        <TextBox x:Name="Formula2BTextBox"
                                                 Grid.Column="3"
                                                 PreviewTextInput="TextBox_PreviewTextInput"
                                                 PreviewKeyDown="TextBox_PreviewKeyDown"
                                                 LostFocus="TextBox_LostFocus"/>

                                    </Grid>

                                    <Grid Grid.Row="2">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="170"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="F:"
                                                   Style="{StaticResource ParameterLabelStyle}"/>

                                        <ComboBox x:Name="Formula2FComboBox"
                                                  Grid.Column="1"/>

                                    </Grid>

                                </Grid>

                            </Grid>

                        </Border>

                        <Border Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrushDark}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="14"
                                Margin="0,0,0,9">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="125"/>
                                    <ColumnDefinition Width="285"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <RadioButton x:Name="Formula3RadioButton"
                                             Grid.Column="0"
                                             GroupName="FormulaGroup"
                                             Content="Формула 3"
                                             Checked="FormulaRadioButton_Checked"/>

                                <Border Grid.Column="1"
                                        Margin="6,0,14,0"
                                        Background="{DynamicResource FormulaBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrushDark}"
                                        BorderThickness="1"
                                        CornerRadius="7"
                                        Padding="6">

                                    <Image x:Name="Formula3Image"
                                           Height="76"
                                           Stretch="Uniform"/>

                                </Border>

                                <Grid x:Name="Formula3InputGrid"
                                      Grid.Column="2"
                                      IsEnabled="False"
                                      Opacity="0.4">

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="7"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="A:"
                                                   Style="{StaticResource ParameterLabelStyle}"/>

                                        <TextBox x:Name="Formula3ATextBox"
                                                 Grid.Column="1"
                                                 PreviewTextInput="TextBox_PreviewTextInput"
                                                 PreviewKeyDown="TextBox_PreviewKeyDown"
                                                 LostFocus="TextBox_LostFocus"/>

                                        <TextBlock Grid.Column="2"
                                                   Text="B:"
                                                   Style="{StaticResource ParameterLabelStyle}"/>

                                        <TextBox x:Name="Formula3BTextBox"
                                                 Grid.Column="3"
                                                 PreviewTextInput="TextBox_PreviewTextInput"
                                                 PreviewKeyDown="TextBox_PreviewKeyDown"
                                                 LostFocus="TextBox_LostFocus"
                                                 TextChanged="Formula3BTextBox_TextChanged"/>

                                    </Grid>

                                    <Grid Grid.Row="2">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="C:"
                                                   Style="{StaticResource ParameterLabelStyle}"/>

                                        <ComboBox x:Name="Formula3CComboBox"
                                                  Grid.Column="1"/>

                                        <TextBlock Grid.Column="2"
                                                   Text="D:"
                                                   Style="{StaticResource ParameterLabelStyle}"/>

                                        <ComboBox x:Name="Formula3DComboBox"
                                                  Grid.Column="3"/>

                                    </Grid>

                                </Grid>

                            </Grid>

                        </Border>

                        <Border Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrushDark}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="14"
                                Margin="0,0,0,9">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="125"/>
                                    <ColumnDefinition Width="285"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <RadioButton x:Name="Formula4RadioButton"
                                             Grid.Column="0"
                                             GroupName="FormulaGroup"
                                             Content="Формула 4"
                                             Checked="FormulaRadioButton_Checked"/>

                                <Border Grid.Column="1"
                                        Margin="6,0,14,0"
                                        Background="{DynamicResource FormulaBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrushDark}"
                                        BorderThickness="1"
                                        CornerRadius="7"
                                        Padding="6">

                                    <Image x:Name="Formula4Image"
                                           Height="82"
                                           Stretch="Uniform"/>

                                </Border>

                                <Grid x:Name="Formula4InputGrid"
                                      Grid.Column="2"
                                      IsEnabled="False"
                                      Opacity="0.4">

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="7"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="A:"
                                                   Style="{StaticResource ParameterLabelStyle}"/>

                                        <TextBox x:Name="Formula4ATextBox"
                                                 Grid.Column="1"
                                                 PreviewTextInput="TextBox_PreviewTextInput"
                                                 PreviewKeyDown="TextBox_PreviewKeyDown"
                                                 LostFocus="TextBox_LostFocus"/>

                                        <TextBlock Grid.Column="2"
                                                   Text="C:"
                                                   Style="{StaticResource ParameterLabelStyle}"/>

                                        <ComboBox x:Name="Formula4CComboBox"
                                                  Grid.Column="3"/>

                                    </Grid>

                                    <Grid Grid.Row="2">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="170"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="D:"
                                                   Style="{StaticResource ParameterLabelStyle}"/>

                                        <TextBox x:Name="Formula4DTextBox"
                                                 Grid.Column="1"
                                                 PreviewTextInput="TextBox_PreviewTextInput"
                                                 PreviewKeyDown="TextBox_PreviewKeyDown"
                                                 LostFocus="TextBox_LostFocus"/>

                                    </Grid>

                                </Grid>

                            </Grid>

                        </Border>


                        <Border Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrushDark}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="14">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="125"/>
                                    <ColumnDefinition Width="285"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <RadioButton x:Name="Variant4RadioButton"
                                             Grid.Column="0"
                                             GroupName="FormulaGroup"
                                             Content="Вариант №4"
                                             Checked="FormulaRadioButton_Checked"/>

                                <Border Grid.Column="1"
                                        Margin="6,0,14,0"
                                        Background="{DynamicResource FormulaBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrushDark}"
                                        BorderThickness="1"
                                        CornerRadius="7"
                                        Padding="6">

                                    <Image x:Name="Variant4Image"
                                           Height="82"
                                           Stretch="Uniform"/>

                                </Border>

                                <Grid x:Name="Variant4InputGrid"
                                      Grid.Column="2"
                                      IsEnabled="False"
                                      Opacity="0.4">

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="7"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="N:"
                                                   Style="{StaticResource ParameterLabelStyle}"/>

                                        <TextBox x:Name="Variant4NTextBox"
                                                 Grid.Column="1"
                                                 PreviewTextInput="TextBox_PreviewTextInput"
                                                 PreviewKeyDown="TextBox_PreviewKeyDown"
                                                 LostFocus="TextBox_LostFocus"/>

                                        <TextBlock Grid.Column="2"
                                                   Text="K:"
                                                   Style="{StaticResource ParameterLabelStyle}"/>

                                        <TextBox x:Name="Variant4KTextBox"
                                                 Grid.Column="3"
                                                 PreviewTextInput="TextBox_PreviewTextInput"
                                                 PreviewKeyDown="TextBox_PreviewKeyDown"
                                                 LostFocus="TextBox_LostFocus"/>

                                    </Grid>

                                    <Grid Grid.Row="2">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="X:"
                                                   Style="{StaticResource ParameterLabelStyle}"/>

                                        <TextBox x:Name="Variant4XTextBox"
                                                 Grid.Column="1"
                                                 PreviewTextInput="TextBox_PreviewTextInput"
                                                 PreviewKeyDown="TextBox_PreviewKeyDown"
                                                 LostFocus="TextBox_LostFocus"/>

                                        <TextBlock Grid.Column="2"
                                                   Text="F:"
                                                   Style="{StaticResource ParameterLabelStyle}"/>

                                        <TextBox x:Name="Variant4FTextBox"
                                                 Grid.Column="3"
                                                 PreviewTextInput="TextBox_PreviewTextInput"
                                                 PreviewKeyDown="TextBox_PreviewKeyDown"
                                                 LostFocus="TextBox_LostFocus"/>

                                        <TextBlock Grid.Column="4"
                                                   Text="Y:"
                                                   Style="{StaticResource ParameterLabelStyle}"/>

                                        <TextBox x:Name="Variant4YTextBox"
                                                 Grid.Column="5"
                                                 PreviewTextInput="TextBox_PreviewTextInput"
                                                 PreviewKeyDown="TextBox_PreviewKeyDown"
                                                 LostFocus="TextBox_LostFocus"/>

                                    </Grid>

                                </Grid>

                            </Grid>

                        </Border>

                    </StackPanel>

                </ScrollViewer>

                <Button x:Name="CalcButton"
                        Grid.Row="4"
                        Content="Рассчитать"
                        Style="{StaticResource CalcButtonStyle}"
                        HorizontalAlignment="Center"
                        Click="Calc_Click"/>

                <Border Grid.Row="6"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrushDark}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14">

                    <StackPanel>

                        <TextBlock Text="Результат"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}"
                                   Margin="0,0,0,8"/>

                        <Border Background="{DynamicResource InputBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrushDark}"
                                BorderThickness="1"
                                CornerRadius="7"
                                Padding="12">

                            <TextBlock x:Name="ResultTextBlock"
                                       MinHeight="24"
                                       FontSize="15"
                                       Foreground="{DynamicResource TextBrush}"
                                       TextWrapping="Wrap"/>

                        </Border>

                    </StackPanel>

                </Border>

            </Grid>

        </Grid>

    </Border>

</Window>