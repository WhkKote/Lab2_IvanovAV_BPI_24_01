<Window x:Class="Lab2_IvanovAV_BPI_24_01.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="Расчёт формул"
        Width="920"
        Height="720"
        MinWidth="820"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource WindowBackgroundBrush}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42"
                            ResizeBorderThickness="6"
                            CornerRadius="10"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border Background="{StaticResource WindowBackgroundBrush}"
            BorderBrush="#303640"
            BorderThickness="1">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource TitleBarBrush}"
                    BorderBrush="#252A31"
                    BorderThickness="0,0,0,1">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="14,0,0,0">

                        <TextBlock Text="Расчёт формул"
                                   Foreground="{StaticResource TextBrush}"
                                   FontSize="13"
                                   VerticalAlignment="Center"/>

                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">

                        <Button Style="{StaticResource WindowButtonStyle}"
                                Click="MinimizeButton_Click">

                            <Border Width="10"
                                    Height="1"
                                    Background="{StaticResource TextBrush}"
                                    VerticalAlignment="Center"
                                    SnapsToDevicePixels="True"/>

                        </Button>

                        <Button x:Name="MaximizeButton"
                                Style="{StaticResource WindowButtonStyle}"
                                Click="MaximizeButton_Click">

                            <Rectangle Width="10"
                                       Height="10"
                                       Stroke="{StaticResource TextBrush}"
                                       StrokeThickness="1"
                                       Fill="Transparent"
                                       SnapsToDevicePixels="True"/>

                        </Button>

                        <Button Style="{StaticResource CloseButtonStyle}"
                                Click="CloseButton_Click">

                            <Grid Width="11"
                                  Height="11">

                                <Path Stroke="{StaticResource TextBrush}"
                                      StrokeThickness="1.2"
                                      Data="M 0 0 L 11 11"/>

                                <Path Stroke="{StaticResource TextBrush}"
                                      StrokeThickness="1.2"
                                      Data="M 11 0 L 0 11"/>

                            </Grid>

                        </Button>

                    </StackPanel>

                </Grid>

            </Border>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <Grid Margin="22">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="9"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="9"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="9"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="9"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="18"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="18"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">

                        <TextBlock Text="Расчёт формул"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}"/>

                        <TextBlock Text="Выберите формулу, введите значения параметров и нажмите «Рассчитать»"
                                   Margin="0,3,0,0"
                                   FontSize="14"
                                   Foreground="{StaticResource SecondaryTextBrush}"/>

                    </StackPanel>

                    <Border Grid.Row="2"
                            Background="{StaticResource CardBackgroundBrush}"
                            BorderBrush="{StaticResource BorderBrushDark}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="14">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="210"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <RadioButton x:Name="Formula1RadioButton"
                                         Grid.Column="0"
                                         GroupName="FormulaGroup"
                                         Content="Формула 1"/>

                            <Border Grid.Column="1"
                                    Margin="6,0,14,0"
                                    Background="#191D22"
                                    BorderBrush="{StaticResource BorderBrushDark}"
                                    BorderThickness="1"
                                    CornerRadius="7"
                                    Padding="6">

                                <Image x:Name="Formula1Image"
                                       Height="48"
                                       Stretch="Uniform"/>

                            </Border>

                            <Grid Grid.Column="2">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="A:"
                                           Style="{StaticResource ParameterLabelStyle}"/>

                                <TextBox x:Name="Formula1ATextBox"
                                         Grid.Column="1"
                                         PreviewTextInput="TextBox_PreviewTextInput"
                                         PreviewKeyDown="TextBox_PreviewKeyDown"
                                         LostFocus="TextBox_LostFocus"/>

                                <TextBlock Grid.Column="2"
                                           Text="F:"
                                           Style="{StaticResource ParameterLabelStyle}"/>

                                <ComboBox x:Name="Formula1FComboBox"
                                          Grid.Column="3"/>

                            </Grid>

                        </Grid>

                    </Border>

                    <Border Grid.Row="4"
                            Background="{StaticResource CardBackgroundBrush}"
                            BorderBrush="{StaticResource BorderBrushDark}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="14">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="210"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <RadioButton x:Name="Formula2RadioButton"
                                         Grid.Column="0"
                                         GroupName="FormulaGroup"
                                         Content="Формула 2"/>

                            <Border Grid.Column="1"
                                    Margin="6,0,14,0"
                                    Background="#191D22"
                                    BorderBrush="{StaticResource BorderBrushDark}"
                                    BorderThickness="1"
                                    CornerRadius="7"
                                    Padding="6">

                                <Image x:Name="Formula2Image"
                                       Height="48"
                                       Stretch="Uniform"/>

                            </Border>

                            <Grid Grid.Column="2">

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="7"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="A:"
                                               Style="{StaticResource ParameterLabelStyle}"/>

                                    <TextBox x:Name="Formula2ATextBox"
                                             Grid.Column="1"
                                             PreviewTextInput="TextBox_PreviewTextInput"
                                             PreviewKeyDown="TextBox_PreviewKeyDown"
                                             LostFocus="TextBox_LostFocus"/>

                                    <TextBlock Grid.Column="2"
                                               Text="B:"
                                               Style="{StaticResource ParameterLabelStyle}"/>

                                    <TextBox x:Name="Formula2BTextBox"
                                             Grid.Column="3"
                                             PreviewTextInput="TextBox_PreviewTextInput"
                                             PreviewKeyDown="TextBox_PreviewKeyDown"
                                             LostFocus="TextBox_LostFocus"/>

                                </Grid>

                                <Grid Grid.Row="2">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="F:"
                                               Style="{StaticResource ParameterLabelStyle}"/>

                                    <ComboBox x:Name="Formula2FComboBox"
                                              Grid.Column="1"/>

                                </Grid>

                            </Grid>

                        </Grid>

                    </Border>

                    <Border Grid.Row="6"
                            Background="{StaticResource CardBackgroundBrush}"
                            BorderBrush="{StaticResource BorderBrushDark}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="14">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="210"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <RadioButton x:Name="Formula3RadioButton"
                                         Grid.Column="0"
                                         GroupName="FormulaGroup"
                                         Content="Формула 3"/>

                            <Border Grid.Column="1"
                                    Margin="6,0,14,0"
                                    Background="#191D22"
                                    BorderBrush="{StaticResource BorderBrushDark}"
                                    BorderThickness="1"
                                    CornerRadius="7"
                                    Padding="6">

                                <Image x:Name="Formula3Image"
                                       Height="54"
                                       Stretch="Uniform"/>

                            </Border>

                            <Grid Grid.Column="2">

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="7"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="A:"
                                               Style="{StaticResource ParameterLabelStyle}"/>

                                    <TextBox x:Name="Formula3ATextBox"
                                             Grid.Column="1"
                                             PreviewTextInput="TextBox_PreviewTextInput"
                                             PreviewKeyDown="TextBox_PreviewKeyDown"
                                             LostFocus="TextBox_LostFocus"/>

                                    <TextBlock Grid.Column="2"
                                               Text="B:"
                                               Style="{StaticResource ParameterLabelStyle}"/>

                                    <TextBox x:Name="Formula3BTextBox"
                                             Grid.Column="3"
                                             PreviewTextInput="TextBox_PreviewTextInput"
                                             PreviewKeyDown="TextBox_PreviewKeyDown"
                                             LostFocus="TextBox_LostFocus"/>

                                </Grid>

                                <Grid Grid.Row="2">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="C:"
                                               Style="{StaticResource ParameterLabelStyle}"/>

                                    <ComboBox x:Name="Formula3CComboBox"
                                              Grid.Column="1"/>

                                    <TextBlock Grid.Column="2"
                                               Text="D:"
                                               Style="{StaticResource ParameterLabelStyle}"/>

                                    <ComboBox x:Name="Formula3DComboBox"
                                              Grid.Column="3"/>

                                </Grid>

                            </Grid>

                        </Grid>

                    </Border>

                    <Border Grid.Row="8"
                            Background="{StaticResource CardBackgroundBrush}"
                            BorderBrush="{StaticResource BorderBrushDark}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="14">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="210"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <RadioButton x:Name="Formula4RadioButton"
                                         Grid.Column="0"
                                         GroupName="FormulaGroup"
                                         Content="Формула 4"/>

                            <Border Grid.Column="1"
                                    Margin="6,0,14,0"
                                    Background="#191D22"
                                    BorderBrush="{StaticResource BorderBrushDark}"
                                    BorderThickness="1"
                                    CornerRadius="7"
                                    Padding="6">

                                <Image x:Name="Formula4Image"
                                       Height="60"
                                       Stretch="Uniform"/>

                            </Border>

                            <Grid Grid.Column="2">

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="7"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="A:"
                                               Style="{StaticResource ParameterLabelStyle}"/>

                                    <TextBox x:Name="Formula4ATextBox"
                                             Grid.Column="1"
                                             PreviewTextInput="TextBox_PreviewTextInput"
                                             PreviewKeyDown="TextBox_PreviewKeyDown"
                                             LostFocus="TextBox_LostFocus"/>

                                    <TextBlock Grid.Column="2"
                                               Text="C:"
                                               Style="{StaticResource ParameterLabelStyle}"/>

                                    <ComboBox x:Name="Formula4CComboBox"
                                              Grid.Column="3"/>

                                </Grid>

                                <Grid Grid.Row="2">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="D:"
                                               Style="{StaticResource ParameterLabelStyle}"/>

                                    <TextBox x:Name="Formula4DTextBox"
                                             Grid.Column="1"
                                             PreviewTextInput="TextBox_PreviewTextInput"
                                             PreviewKeyDown="TextBox_PreviewKeyDown"
                                             LostFocus="TextBox_LostFocus"/>

                                </Grid>

                            </Grid>

                        </Grid>

                    </Border>

                    <Border Grid.Row="10"
                            Background="{StaticResource CardBackgroundBrush}"
                            BorderBrush="{StaticResource BorderBrushDark}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="14">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="210"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <RadioButton x:Name="Variant4RadioButton"
                                         Grid.Column="0"
                                         GroupName="FormulaGroup"
                                         Content="Вариант №4"/>

                            <Border Grid.Column="1"
                                    Margin="6,0,14,0"
                                    Background="#191D22"
                                    BorderBrush="{StaticResource BorderBrushDark}"
                                    BorderThickness="1"
                                    CornerRadius="7"
                                    Padding="6">

                                <Image x:Name="Variant4Image"
                                       Height="64"
                                       Stretch="Uniform"/>

                            </Border>

                            <Grid Grid.Column="2">

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="7"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="N:"
                                               Style="{StaticResource ParameterLabelStyle}"/>

                                    <TextBox x:Name="Variant4NTextBox"
                                             Grid.Column="1"
                                             PreviewTextInput="TextBox_PreviewTextInput"
                                             PreviewKeyDown="TextBox_PreviewKeyDown"
                                             LostFocus="TextBox_LostFocus"/>

                                    <TextBlock Grid.Column="2"
                                               Text="K:"
                                               Style="{StaticResource ParameterLabelStyle}"/>

                                    <TextBox x:Name="Variant4KTextBox"
                                             Grid.Column="3"
                                             PreviewTextInput="TextBox_PreviewTextInput"
                                             PreviewKeyDown="TextBox_PreviewKeyDown"
                                             LostFocus="TextBox_LostFocus"/>

                                </Grid>

                                <Grid Grid.Row="2">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="X:"
                                               Style="{StaticResource ParameterLabelStyle}"/>

                                    <TextBox x:Name="Variant4XTextBox"
                                             Grid.Column="1"
                                             PreviewTextInput="TextBox_PreviewTextInput"
                                             PreviewKeyDown="TextBox_PreviewKeyDown"
                                             LostFocus="TextBox_LostFocus"/>

                                    <TextBlock Grid.Column="2"
                                               Text="F:"
                                               Style="{StaticResource ParameterLabelStyle}"/>

                                    <TextBox x:Name="Variant4FTextBox"
                                             Grid.Column="3"
                                             PreviewTextInput="TextBox_PreviewTextInput"
                                             PreviewKeyDown="TextBox_PreviewKeyDown"
                                             LostFocus="TextBox_LostFocus"/>

                                    <TextBlock Grid.Column="4"
                                               Text="Y:"
                                               Style="{StaticResource ParameterLabelStyle}"/>

                                    <TextBox x:Name="Variant4YTextBox"
                                             Grid.Column="5"
                                             PreviewTextInput="TextBox_PreviewTextInput"
                                             PreviewKeyDown="TextBox_PreviewKeyDown"
                                             LostFocus="TextBox_LostFocus"/>

                                </Grid>

                            </Grid>

                        </Grid>

                    </Border>

                    <Button x:Name="CalcButton"
                            Grid.Row="12"
                            Content="Рассчитать"
                            Style="{StaticResource CalcButtonStyle}"
                            HorizontalAlignment="Center"
                            Click="Calc_Click"/>

                    <Border Grid.Row="14"
                            Background="{StaticResource CardBackgroundBrush}"
                            BorderBrush="{StaticResource BorderBrushDark}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="14">

                        <StackPanel>

                            <TextBlock Text="Результат"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}"
                                       Margin="0,0,0,8"/>

                            <Border Background="#191D22"
                                    BorderBrush="{StaticResource BorderBrushDark}"
                                    BorderThickness="1"
                                    CornerRadius="7"
                                    Padding="12">

                                <TextBlock x:Name="ResultTextBlock"
                                           MinHeight="24"
                                           FontSize="15"
                                           Foreground="{StaticResource TextBrush}"
                                           TextWrapping="Wrap"/>

                            </Border>

                        </StackPanel>

                    </Border>

                </Grid>

            </ScrollViewer>

        </Grid>

    </Border>

</Window>